# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.

# --- Neon Postgres ---------------------------------------------------------
# Neon dashboard > Connect. Use the *pooled* string (host contains `-pooler`)
# and keep `sslmode=require`. Read at runtime by the Neon serverless driver
# and by drizzle-kit for migrations.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Better Auth -----------------------------------------------------------
# Signing secret, 32+ random chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# Public origin of this app, no trailing slash.
BETTER_AUTH_URL="http://localhost:3000"
